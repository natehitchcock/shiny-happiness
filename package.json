{
  "name": "roundtable",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/web/tsconfig.json",
    "pretest": "turbo run build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@roundtable/api": "workspace:*",
    "@roundtable/db": "workspace:*",
    "fastify": "^5.12.1"
  }
}
