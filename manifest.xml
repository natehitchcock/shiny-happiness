<?xml version="1.0"?>
<!--
  Connect IQ manifest for the BLE Radar watch app.

  VERIFY before building on your PC:
    * The Venu 4 product id string ("venu4") and the exact minApiLevel it
      supports on Garmin's Compatible Devices page. BLE central scanning needs
      a device/API level that supports Toybox.BluetoothLowEnergy central role.
    * If you target additional devices, add more <iq:product> entries and test
      each screen resolution.
  The application id below was generated for this project; keep it stable so the
  app updates in place rather than installing as a new app.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="2847a58d8cdc4dabac72805f32f8b09d"
        type="watch-app"
        name="@Strings.AppName"
        entry="RadarApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.0">

        <iq:products>
            <iq:product id="venu4"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
