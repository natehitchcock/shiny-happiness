{
  "name": "@roundtable/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design-system primitives. No app logic.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./card.css": "./src/card/card.css"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "tokens": "tsc -b && node scripts/generate-tokens.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
